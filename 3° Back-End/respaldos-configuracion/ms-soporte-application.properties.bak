# Nombre y puerto del microservicio
spring.application.name=ms-soporte
server.port=${PORT:8087}
# Lote 5 (HU-78): Soporte ahora tiene una ruta /api/v1/internal/**. Igual que los demás MS con rutas internas:
# medida COMPLEMENTARIA (no es autenticación) hasta el JWT de servicio del Lote 6 (DOC-05). Otro PC: SERVER_ADDRESS=0.0.0.0
server.address=${SERVER_ADDRESS:127.0.0.1}

# Lote 1: lee variables locales desde .env (igual que ms-accounts). Ver .env.example
spring.config.import=optional:file:.env[.properties]

# Configuración de base de datos MySQL
# Lote 1: misma base, mismo driver y mismos valores por defecto; solo se pueden cambiar desde el .env
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/bd_soporte?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC}
spring.datasource.username=${DB_USER:root}
spring.datasource.password=${DB_PASSWORD:}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
# Formato SQL en consola y dialecto de MySQL
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.open-in-view=false

# Lote 1: secreto del JWT emitido por ms-accounts. OBLIGATORIO y el MISMO en todos los MS (mín. 32 caracteres).
security.jwt.secret=${JWT_SECRET}

# Lote 1: MS-Notifications (HU-59, HU-65, HU-67: avisos al cliente). Si no responde, el ticket se guarda igual.
# Lote 1.1: 127.0.0.1 (no "localhost") porque ms-notifications escucha solo en 127.0.0.1 (server.address).
# Si Notifications corre en OTRO PC: NOTIFICATIONS_URL=http://<ip-de-ese-pc>:8086 y allí SERVER_ADDRESS=0.0.0.0
services.notifications.url=${NOTIFICATIONS_URL:http://127.0.0.1:8086}

# Swagger (mismas rutas que los demás MS)
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.api-docs.path=/v3/api-docs

# Lote 5 (HU-78, RN-37, RN-44): MS-Accounts confirma que la cuenta está ACTIVA antes de crear un ticket.
# Si no responde, se rechaza con 503 (no se crea el ticket).
services.accounts.url=${ACCOUNTS_URL:http://127.0.0.1:8081}

# ---- Lote 6 · DOC-05: JWT de servicio (llamadas MS -> MS). Secreto DISTINTO de JWT_SECRET, el mismo en los 6 MS ----
security.service-jwt.secret=${SERVICE_JWT_SECRET}
# ---- Lote 6 · DOC-06: el correlationId aparece en cada línea de log ----
logging.pattern.correlation=[%X{correlationId:-}]\u0020

# ---- Cierre (RF-SOP-01): Orders confirma que el pedido asociado a un ticket es del Cliente (escucha en 127.0.0.1) ----
services.orders.url=${ORDERS_URL:http://127.0.0.1:8084}
