# Copiar como .env (mismo directorio) y ajustar. VS Code lo carga al ejecutar con launch.json.
DB_USER=root
DB_PASSWORD=
# Debe ser IGUAL en ms-accounts, ms-catalog y los servicios que validan JWT de usuario (mínimo 32 caracteres)
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas
# Lote 2: el inventario ya está dentro de ms-catalog (no se necesita INVENTORY_URL).
# Opcional: umbral crítico inicial de los productos nuevos (por defecto 5)
# UMBRAL_CRITICO_DEFECTO=5
# Lote 5: Accounts confirma que la cuenta está ACTIVA antes de agregar un favorito
ACCOUNTS_URL=http://127.0.0.1:8081

# Lote 6 · DOC-05: secreto del JWT de servicio (MS -> MS). Igual en los 6 MS, DISTINTO de JWT_SECRET, mínimo 32 caracteres.
SERVICE_JWT_SECRET=cambiar-por-otro-secreto-largo-distinto-de-JWT_SECRET
