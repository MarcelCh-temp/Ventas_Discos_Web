# API Gateway (Lote 6). Copiar como .env (mismo directorio) y ajustar; VS Code lo carga con launch.json. NO subir valores reales.
PORT=8080

# Mismo valor que JWT_SECRET de los 6 microservicios (lo emite MS-Accounts). Mínimo 32 caracteres.
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas

# Orígenes exactos del frontend, separados por coma. NO usar "*".
# Valor inicial: Live Server (puerto 5500). Cuando el frontend definitivo esté listo, agregar su origen real
# (por ejemplo, Vite usa http://localhost:5173).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# URL de cada microservicio (los MS escuchan solo en 127.0.0.1)
ACCOUNTS_URL=http://127.0.0.1:8081
CATALOG_URL=http://127.0.0.1:8082
ORDERS_URL=http://127.0.0.1:8084
POSTSALE_URL=http://127.0.0.1:8085
NOTIFICATIONS_URL=http://127.0.0.1:8086
SUPPORT_URL=http://127.0.0.1:8087

# Cierre (ERS 12.7): tiempos máximos hacia los microservicios (formato de duración de Spring: 2s, 30s, 500ms)
GATEWAY_CONNECT_TIMEOUT=2s
GATEWAY_READ_TIMEOUT=30s

# El Gateway NO usa SERVICE_JWT_SECRET: las llamadas MS -> MS no pasan por aquí.
