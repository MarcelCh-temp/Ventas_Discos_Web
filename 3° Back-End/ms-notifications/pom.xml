<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">


    <modelVersion>4.0.0</modelVersion>


    <!-- ================================================== -->
    <!-- 1. CONFIGURACION PRINCIPAL DE SPRING BOOT           -->
    <!-- ================================================== -->


    <!-- Define la version de Spring Boot y administra
         las versiones compatibles de sus dependencias. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>


    <!-- ================================================== -->
    <!-- 2. INFORMACION DEL MICROSERVICIO                    -->
    <!-- ================================================== -->


    <!-- Identificador de la organizacion o proyecto. -->
    <groupId>com.ventasdiscos</groupId>


    <!-- Nombre del microservicio dentro de Maven. -->
    <artifactId>ms-notifications</artifactId>


    <!-- Version actual de desarrollo. -->
    <version>0.0.1-SNAPSHOT</version>


    <name>ms-notifications</name>
    <description>Microservicio de notificaciones de Akiba Store</description>


    <!-- ================================================== -->
    <!-- 3. VERSION DE JAVA                                  -->
    <!-- ================================================== -->


    <properties>
        <!-- Version utilizada para compilar el proyecto. -->
        <java.version>25</java.version>
    </properties>


    <!-- ================================================== -->
    <!-- 4. DEPENDENCIAS DEL MICROSERVICIO                   -->
    <!-- ================================================== -->


    <dependencies>


        <!-- SPRING WEB MVC
             Permite crear controladores REST mediante
             anotaciones como @RestController, @GetMapping
             y @PostMapping. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>


        <!-- SPRING DATA JPA
             Permite trabajar con entidades @Entity,
             repositorios JpaRepository y persistencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>


        <!-- VALIDATION
             Habilita las validaciones de Jakarta,
             incluyendo @NotNull, @NotBlank, @Email,
             @Size, @Positive y @Valid. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!-- ACTUATOR
             Proporciona funcionalidades de monitoreo
             y comprobacion del estado del servicio. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>


        <!-- MYSQL CONNECTOR/J
             Driver JDBC que permite conectar el
             microservicio con una base de datos MySQL.


             Reemplaza completamente mysql-connector-j. -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>


        <!-- LOMBOK
             Reduce codigo repetitivo mediante
             anotaciones como @Getter, @Setter,
             @NoArgsConstructor y @AllArgsConstructor. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>


        <!-- SWAGGER / OPENAPI
             Permite visualizar y documentar los
             endpoints REST del microservicio. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>


        <!-- NIMBUS JOSE JWT
             Permite procesar y validar tokens JWT
             utilizados para autenticar solicitudes
             de usuarios y comunicaciones internas. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>9.37.3</version>
        </dependency>


        <!-- ================================================== -->
        <!-- 5. DEPENDENCIAS PARA PRUEBAS                      -->
        <!-- ================================================== -->


        <!-- SPRING BOOT TEST
             Incluye herramientas para realizar
             pruebas automatizadas con JUnit y Mockito. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- PRUEBAS WEB MVC
             Permite probar controladores y endpoints
             HTTP sin levantar toda la aplicacion. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- PRUEBAS JPA
             Permite probar repositorios y operaciones
             relacionadas con la persistencia. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- PRUEBAS DE VALIDACION
             Proporciona herramientas para comprobar
             las restricciones declaradas en los datos. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!-- BASE DE DATOS H2
             Se utiliza exclusivamente durante las pruebas
             automatizadas. No reemplaza MySQL en ejecucion. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>


    </dependencies>


    <!-- ================================================== -->
    <!-- 6. PLUGINS DE MAVEN                                 -->
    <!-- ================================================== -->


    <build>
        <plugins>


            <!-- SPRING BOOT MAVEN PLUGIN
                 Permite ejecutar y empaquetar
                 el microservicio desde Maven. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>


            <!-- MAVEN COMPILER PLUGIN
                 Configura la compilacion de Java
                 y el procesamiento de Lombok. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>


                <configuration>
                    <!-- Conserva los nombres de parametros
                         de los metodos al compilar. -->
                    <parameters>true</parameters>


                    <!-- Procesa las anotaciones de Lombok
                         durante la compilacion. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>


        </plugins>
    </build>


</project>