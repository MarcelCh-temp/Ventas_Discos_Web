# Copiar como .env (en esta misma carpeta) y ajustar. El .env NO se sube a Git.
DB_USERNAME=root
DB_PASSWORD=
# Debe ser IGUAL en todos los MS (mínimo 32 caracteres)
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas

# Lote 6 · DOC-05: secreto del JWT de servicio (MS -> MS). Igual en los 6 MS, DISTINTO de JWT_SECRET, mínimo 32 caracteres.
SERVICE_JWT_SECRET=cambiar-por-otro-secreto-largo-distinto-de-JWT_SECRET
# Cierre (RN-44): Accounts confirma que la cuenta está ACTIVA antes de atender al Cliente
ACCOUNTS_URL=http://127.0.0.1:8081
