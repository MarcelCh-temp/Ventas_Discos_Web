# Copiar como .env (mismo directorio) y ajustar. VS Code lo carga al ejecutar con launch.json.
DB_USER=root
DB_PASSWORD=
# Debe ser IGUAL en ms-accounts, ms-catalog y ms-inventory (mínimo 32 caracteres)
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas
# Administrador inicial (el registro público solo crea Clientes)
ADMIN_RUT=11111111-1
ADMIN_EMAIL=admin@tienda.cl
# Elige TU clave (mín. 8 caracteres). No se deja una clave compartida por defecto.
ADMIN_PASSWORD=
