# Copiar como .env (mismo directorio) y ajustar. VS Code lo carga al ejecutar con launch.json.
DB_USER=root
DB_PASSWORD=
# Debe ser IGUAL en todos los MS (mínimo 32 caracteres)
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas
# Administrador inicial (el registro público solo crea Clientes)
ADMIN_RUT=11111111-1
ADMIN_EMAIL=admin@tienda.cl
# Elige TU clave (mín. 8 caracteres). No se deja una clave compartida por defecto.
ADMIN_PASSWORD=
# Lote 5 (HU-78): URLs de los MS que Accounts consulta al eliminar una cuenta (127.0.0.1 porque escuchan solo ahí)
ORDERS_URL=http://127.0.0.1:8084
SUPPORT_URL=http://127.0.0.1:8087
POSTSALE_URL=http://127.0.0.1:8085
CATALOG_URL=http://127.0.0.1:8082
NOTIFICATIONS_URL=http://127.0.0.1:8086

# Lote 6 · DOC-05: secreto del JWT de servicio (MS -> MS). Igual en los 6 MS, DISTINTO de JWT_SECRET, mínimo 32 caracteres.
SERVICE_JWT_SECRET=cambiar-por-otro-secreto-largo-distinto-de-JWT_SECRET
