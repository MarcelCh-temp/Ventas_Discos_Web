# Copiar como .env (en esta misma carpeta) y ajustar. El .env NO se sube a Git.
DB_USER=root
DB_PASSWORD=
# Debe ser IGUAL en todos los MS (mínimo 32 caracteres)
JWT_SECRET=cambiar-por-un-secreto-largo-de-32-caracteres-o-mas
NOTIFICATIONS_URL=http://127.0.0.1:8086
# Lote 5: Accounts confirma que la cuenta está ACTIVA antes de crear un ticket
ACCOUNTS_URL=http://127.0.0.1:8081

# Lote 6 · DOC-05: secreto del JWT de servicio (MS -> MS). Igual en los 6 MS, DISTINTO de JWT_SECRET, mínimo 32 caracteres.
SERVICE_JWT_SECRET=cambiar-por-otro-secreto-largo-distinto-de-JWT_SECRET
# Cierre (RF-SOP-01): Orders confirma que el pedido asociado a un ticket es del Cliente
ORDERS_URL=http://127.0.0.1:8084

# Opcionales: mantener el motor actual o configurar un MySQL 8+ acordado por el equipo.
# DB_URL=jdbc:mysql://localhost:3306/NOMBRE_BD?useSSL=false&serverTimezone=UTC
# DB_DIALECT=org.hibernate.dialect.MySQLDialect
# DB_DDL_AUTO=validate
